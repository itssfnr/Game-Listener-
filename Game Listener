local function CreateCar(
	vehicleName,
	spawnPosition
)

	local data = VEHICLES[vehicleName]

	if not data then
		return
	end

	-- Remove old vehicle

	if CurrentVehicle then
		CurrentVehicle:Destroy()
		CurrentVehicle = nil
	end

	local model = Instance.new("Model")

	model.Name =
		vehicleName ..
		"_Vehicle"

	model.Parent = CarsFolder

	--==========================================================
	-- MAIN BODY
	--==========================================================

	local bodyCF =
		CFrame.new(
			spawnPosition
		)

	local body = VehiclePart(
		"VehicleBody",
		data.BodySize,
		bodyCF,
		data.Color,
		Enum.Material.SmoothPlastic,
		model
	)

	model.PrimaryPart = body

	--==========================================================
	-- CAR VS MOTORCYCLE
	--==========================================================

	if data.Motorcycle then

		--======================================================
		-- MOTORCYCLE FRAME
		--======================================================

		local frame = VehiclePart(
			"MotorcycleFrame",
			Vector3.new(
				1.3,
				0.8,
				5
			),
			bodyCF *
				CFrame.new(
					0,
					1.2,
					0
				),
			data.Secondary,
			Enum.Material.Metal,
			model
		)

		-- Tank

		local tank = VehiclePart(
			"FuelTank",
			Vector3.new(
				2.2,
				1.2,
				2.2
			),
			bodyCF *
				CFrame.new(
					0,
					1.5,
					0.5
				),
			data.Color,
			Enum.Material.SmoothPlastic,
			model
		)

		-- Seat

		local seat = Instance.new("Seat")

		seat.Name = "DriverSeat"

		seat.Size = Vector3.new(
			1.8,
			0.5,
			1.8
		)

		seat.CFrame =
			bodyCF *
			CFrame.new(
				0,
				2,
				-1
			)

		seat.Color =
			Color3.fromRGB(
				25,
				25,
				25
			)

		seat.Anchored = true

		seat.Parent = model

		-- Handlebars

		local handlebars = VehiclePart(
			"Handlebars",
