local function VehiclePart(
	name,
	size,
	cf,
	color,
	material,
	model
)

	local p = Instance.new("Part")

	p.Name = name
	p.Size = size

	p.CFrame = cf

	p.Color = color
	p.Material = material

	p.Anchored = true

	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth

	p.Parent = model

	return p
end

--==============================================================
-- WHEEL
--==============================================================

local function CreateWheel(
	model,
	name,
	offset,
	size,
	body,
	color
)

	local wheel = Instance.new("Part")

	wheel.Name = name

	wheel.Shape = Enum.PartType.Cylinder

	wheel.Size = size

	wheel.Color = Color3.fromRGB(
		15,
		15,
		17
	)

	wheel.Material = Enum.Material.Rubber

	wheel.Anchored = true

	wheel.CFrame =
		body.CFrame *
		CFrame.new(offset) *
		CFrame.Angles(
			0,
			0,
			math.rad(90)
		)

	wheel.Parent = model

	-- Rim

	local rim = Instance.new("Part")

	rim.Name = "Rim"

	rim.Shape = Enum.PartType.Cylinder

	rim.Size = Vector3.new(
		size.X + 0.05,
		size.Y * 0.45,
		size.Z * 0.45
	)

	rim.Color = color

	rim.Material = Enum.Material.Metal

	rim.Anchored = true

	rim.CFrame = wheel.CFrame

	rim.Parent = model

	return wheel
end

