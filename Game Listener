-- DRONE CONTROLLER
-- W/S = vor/zurück
-- A/D = links/rechts
-- Space = hoch
-- LeftControl = runter
-- Shift = Boost
-- Q = Drohne verlassen

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local flying = false
local drone
local droneCore

local keys = {
	W = false,
	S = false,
	A = false,
	D = false,
	Up = false,
	Down = false,
	Boost = false
}

local speed = 55
local boostSpeed = 100
local verticalSpeed = 38

local function createPart(parent, name, size, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.Anchored = false
	p.Parent = parent
	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
	return w
end

local function createDrone()

	if drone then
		drone:Destroy()
	end

	drone = Instance.new("Model")
	drone.Name = "PlayerDrone"
	drone.Parent = workspace

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	local spawnPosition =
		root and
		(root.Position + Vector3.new(0, 8, -4))
		or Vector3.new(0, 20, 0)

	droneCore = createPart(
		drone,
		"DroneCore",
		Vector3.new(3, 0.65, 3),
		Color3.fromRGB(20, 23, 30),
		Enum.Material.Metal
	)

	droneCore.CFrame =
		CFrame.new(spawnPosition)

	drone.PrimaryPart = droneCore

	-- obere Platte
	local top = createPart(
		drone,
		"Top",
		Vector3.new(2.2, 0.25, 2.2),
		Color3.fromRGB(45, 48, 58),
		Enum.Material.Metal
	)

	top.CFrame =
		droneCore.CFrame *
		CFrame.new(0, 0.45, 0)

	weld(droneCore, top)

	-- Kamera
	local cameraMount = createPart(
		drone,
		"CameraMount",
		Vector3.new(1.15, 0.65, 0.55),
		Color3.fromRGB(8, 10, 13),
		Enum.Material.Metal
	)

	cameraMount.CFrame =
		droneCore.CFrame *
		CFrame.new(0, -0.05, -1.55)

	weld(droneCore, cameraMount)

	-- Kamera-Linse
	local lens = createPart(
		drone,
		"CameraLens",
		Vector3.new(0.65, 0.42, 0.15),
		Color3.fromRGB(20, 120, 190),
		Enum.Material.Neon
	)

	lens.CFrame =
		cameraMount.CFrame *
		CFrame.new(0, 0, -0.35)

	weld(cameraMount, lens)

	-- Arme
	local armPositions = {
		Vector3.new( 2.0, 0,  2.0),
		Vector3.new(-2.0, 0,  2.0),
		Vector3.new( 2.0, 0, -2.0),
		Vector3.new(-2.0, 0, -2.0),
	}

	for i, offset in ipairs(armPositions) do

		local arm = createPart(
			drone,
			"Arm" .. i,
			Vector3.new(2.4, 0.22, 0.22),
			Color3.fromRGB(35, 38, 45),
			Enum.Material.Metal
		)

		arm.CFrame =
			droneCore.CFrame *
			CFrame.new(offset/2) *
			CFrame.Angles(
				0,
				math.rad(45),
				0
			)

		weld(droneCore, arm)

		local motor = createPart(
			drone,
			"Motor" .. i,
			Vector3.new(0.65, 0.35, 0.65),
			Color3.fromRGB(12, 13, 17),
			Enum.Material.Metal
		)

		motor.CFrame =
			droneCore.CFrame *
			CFrame.new(offset)

		weld(droneCore, motor)

		-- Rotor
		local rotor = createPart(
			drone,
			"Rotor" .. i,
			Vector3.new(2.2, 0.05, 0.18),
			Color3.fromRGB(15, 16, 20),
			Enum.Material.SmoothPlastic
		)

		rotor.CFrame =
			motor.CFrame

		weld(motor, rotor)

	end

	-- LED-Leisten
	for _, offset in ipairs({
		Vector3.new(-1.25, 0.05, -1.55),
		Vector3.new( 1.25, 0.05, -1.55)
	}) do

		local led = createPart(
			drone,
			"LED",
			Vector3.new(0.65, 0.08, 0.12),
			Color3.fromRGB(0, 190, 255),
			Enum.Material.Neon
		)

		led.CFrame =
			droneCore.CFrame *
			CFrame.new(offset)

		weld(droneCore, led)

	end

	-- Light
	local lightPart = createPart(
		drone,
		"Spotlight",
		Vector3.new(0.5, 0.15, 0.5),
		Color3.fromRGB(230, 245, 255),
		Enum.Material.Neon
	)

	lightPart.CFrame =
		droneCore.CFrame *
		CFrame.new(0, -0.4, -1)

	weld(droneCore, lightPart)

	local light = Instance.new("SpotLight")
	light.Brightness = 4
	light.Range = 35
	light.Angle = 70
	light.Color = Color3.fromRGB(190, 235, 255)
	light.Parent = lightPart

	-- Physik
	local attachment = Instance.new("Attachment")
	attachment.Parent = droneCore

	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.MaxForce = math.huge
	velocity.VectorVelocity = Vector3.zero
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.Parent = droneCore

	local angular = Instance.new("AngularVelocity")
	angular.Attachment0 = attachment
	angular.MaxTorque = math.huge
	angular.AngularVelocity = Vector3.zero
	angular.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
	angular.Parent = droneCore

	return velocity, angular
end

local velocityController
local rotationController

local function startDrone()

	if flying then
		return
	end

	flying = true

	velocityController, rotationController =
		createDrone()

	camera.CameraType = Enum.CameraType.Scriptable

end

local function stopDrone()

	if not flying then
		return
	end

	flying = false

	if drone then
		drone:Destroy()
		drone = nil
	end

	droneCore = nil

	camera.CameraType = Enum.CameraType.Custom

end

-- Start automatisch
startDrone()

UserInputService.InputBegan:Connect(function(input, processed)

	if processed then
		return
	end

	if input.KeyCode == Enum.KeyCode.W then
		keys.W = true
	elseif input.KeyCode == Enum.KeyCode.S then
		keys.S = true
	elseif input.KeyCode == Enum.KeyCode.A then
		keys.A = true
	elseif input.KeyCode == Enum.KeyCode.D then
		keys.D = true
	elseif input.KeyCode == Enum.KeyCode.Space then
		keys.Up = true
	elseif input.KeyCode == Enum.KeyCode.LeftControl then
		keys.Down = true
	elseif input.KeyCode == Enum.KeyCode.LeftShift then
		keys.Boost = true
	elseif input.KeyCode == Enum.KeyCode.Q then
		stopDrone()
	end

end)

UserInputService.InputEnded:Connect(function(input)

	if input.KeyCode == Enum.KeyCode.W then
		keys.W = false
	elseif input.KeyCode == Enum.KeyCode.S then
		keys.S = false
	elseif input.KeyCode == Enum.KeyCode.A then
		keys.A = false
	elseif input.KeyCode == Enum.KeyCode.D then
		keys.D = false
	elseif input.KeyCode == Enum.KeyCode.Space then
		keys.Up = false
	elseif input.KeyCode == Enum.KeyCode.LeftControl then
		keys.Down = false
	elseif input.KeyCode == Enum.KeyCode.LeftShift then
		keys.Boost = false
	end

end)

local smoothVelocity = Vector3.zero
local smoothTilt = Vector3.zero

RunService.RenderStepped:Connect(function(dt)

	if not flying then
		return
	end

	if not droneCore or not droneCore.Parent then
		return
	end

	-- Bewegungsrichtung
	local move = Vector3.zero

	if keys.W then
		move += Vector3.new(0, 0, -1)
	end

	if keys.S then
		move += Vector3.new(0, 0, 1)
	end

	if keys.A then
		move += Vector3.new(-1, 0, 0)
	end

	if keys.D then
		move += Vector3.new(1, 0, 0)
	end

	if keys.Up then
		move += Vector3.new(0, 1, 0)
	end

	if keys.Down then
		move += Vector3.new(0, -1, 0)
	end

	if move.Magnitude > 0 then
		move = move.Unit
	end

	local currentSpeed =
		keys.Boost and boostSpeed or speed

	local desired =
		droneCore.CFrame:VectorToWorldSpace(move)
		* currentSpeed

	-- weiches Schweben
	smoothVelocity =
		smoothVelocity:Lerp(
			desired,
			math.clamp(dt * 5, 0, 1)
		)

	velocityController.VectorVelocity =
		smoothVelocity

	-- Neigung
	local pitch = 0
	local roll = 0

	if keys.W then
		pitch = math.rad(-12)
	elseif keys.S then
		pitch = math.rad(12)
	end

	if keys.A then
		roll = math.rad(14)
	elseif keys.D then
		roll = math.rad(-14)
	end

	smoothTilt =
		smoothTilt:Lerp(
			Vector3.new(
				pitch,
				0,
				roll
			),
			math.clamp(dt * 7, 0, 1)
		)

	-- Drohnenrotation
	rotationController.AngularVelocity =
		Vector3.new(
			0,
			(keys.A and 0.7 or 0) +
			(keys.D and -0.7 or 0),
			0
		)

	-- Kamera hinter der Drohne
	local camDistance = keys.Boost and 13 or 10

	local cameraPosition =
		droneCore.Position
		- droneCore.CFrame.LookVector * camDistance
		+ Vector3.new(0, 5, 0)

	local target =
		droneCore.Position
		+ droneCore.CFrame.LookVector * 8

	local desiredCamera =
		CFrame.lookAt(
			cameraPosition,
			target
		)

	camera.CFrame =
		camera.CFrame:Lerp(
			desiredCamera,
			math.clamp(dt * 8, 0, 1)
		)

end)
