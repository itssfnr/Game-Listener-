--==============================================================
-- SKYDRONE X
-- ONE LOCAL SCRIPT
--
-- WASD       = fliegen
-- SPACE      = hoch
-- CTRL       = runter
-- SHIFT      = Boost
-- MOUSE      = Kamera bewegen
-- RMB        = Kamera-Fokus
-- F          = Training-Laser
-- Q          = Drohnenmodus verlassen
-- R          = Drohne neu starten
--==============================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

--==============================================================
-- SETTINGS
--==============================================================

local NORMAL_SPEED = 55
local BOOST_SPEED = 105
local VERTICAL_SPEED = 42

local CAMERA_DISTANCE = 12
local CAMERA_HEIGHT = 5

local MOUSE_SENSITIVITY = 0.0025
local CAMERA_SMOOTH = 10

local flying = false
local boosting = false
local firing = false

local drone
local core
local velocityController
local angularController

local rotors = {}
local leds = {}
local thrusters = {}

local yaw = 0
local pitch = -0.18

local cameraYaw = 0
local cameraPitch = -0.18

local currentVelocity = Vector3.zero

local keys = {
	W = false,
	S = false,
	A = false,
	D = false,
	Up = false,
	Down = false
}

--==============================================================
-- HELPERS
--==============================================================

local function makePart(parent, name, size, color, material)
	local p = Instance.new("Part")

	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic

	p.Anchored = false
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true

	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth

	p.Parent = parent

	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
	return w
end

local function createLight(parent, color, range, brightness)
	local light = Instance.new("PointLight")

	light.Color = color
	light.Range = range
	light.Brightness = brightness

	light.Parent = parent

	return light
end

--==============================================================
-- DRONE CREATION
--==============================================================

local function createDrone()

	if drone then
		drone:Destroy()
	end

	rotors = {}
	leds = {}
	thrusters = {}

	drone = Instance.new("Model")
	drone.Name = "SkyDrone"
	drone.Parent = workspace

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	local spawnPosition

	if root then
		spawnPosition =
			root.Position
			+ Vector3.new(0, 12, 0)
	else
		spawnPosition = Vector3.new(0, 30, 0)
	end

	--==========================================================
	-- CORE
	--==========================================================

	core = makePart(
		drone,
		"Core",
		Vector3.new(3.4, 0.65, 3.4),
		Color3.fromRGB(17, 20, 27),
		Enum.Material.Metal
	)

	core.CFrame = CFrame.new(spawnPosition)

	drone.PrimaryPart = core

	--==========================================================
	-- BODY SHELL
	--==========================================================

	local shell = makePart(
		drone,
		"Shell",
		Vector3.new(2.7, 0.45, 2.7),
		Color3.fromRGB(35, 40, 50),
		Enum.Material.SmoothPlastic
	)

	shell.CFrame =
		core.CFrame *
		CFrame.new(0, 0.45, 0)

	weld(core, shell)

	--==========================================================
	-- FRONT CAMERA
	--==========================================================

	local cameraHousing = makePart(
		drone,
		"CameraHousing",
		Vector3.new(1.25, 0.7, 0.7),
		Color3.fromRGB(8, 10, 14),
		Enum.Material.Metal
	)

	cameraHousing.CFrame =
		core.CFrame *
		CFrame.new(0, -0.05, -1.65)

	weld(core, cameraHousing)

	local lens = makePart(
		drone,
	"CameraLens",
		Vector3.new(0.72, 0.5, 0.15),
		Color3.fromRGB(15, 115, 190),
		Enum.Material.Neon
	)

	lens.CFrame =
		cameraHousing.CFrame *
		CFrame.new(0, 0, -0.4)

	weld(cameraHousing, lens)

	local lensLight =
		createLight(
			lens,
			Color3.fromRGB(20, 150, 255),
			7,
			1.5
		)

	--==========================================================
	-- ARMS
	--==========================================================

	local armData = {
		Vector3.new( 2.1, 0,  2.1),
		Vector3.new(-2.1, 0,  2.1),
		Vector3.new( 2.1, 0, -2.1),
		Vector3.new(-2.1, 0, -2.1)
	}

	for i, offset in ipairs(armData) do

		local arm = makePart(
			drone,
			"Arm_" .. i,
			Vector3.new(2.8, 0.22, 0.24),
			Color3.fromRGB(30, 34, 42),
			Enum.Material.Metal
		)

		arm.CFrame =
			core.CFrame *
			CFrame.new(offset / 2) *
			CFrame.Angles(
				0,
				math.rad(45),
				0
			)

		weld(core, arm)

		--======================================================
		-- MOTOR
		--======================================================

		local motor = makePart(
			drone,
			"Motor_" .. i,
			Vector3.new(0.7, 0.4, 0.7),
			Color3.fromRGB(8, 9, 12),
			Enum.Material.Metal
		)

		motor.CFrame =
			core.CFrame *
			CFrame.new(offset)

		weld(core, motor)

		--======================================================
		-- ROTOR
		--======================================================

		local rotor = makePart(
			drone,
			"Rotor_" .. i,
			Vector3.new(2.25, 0.06, 0.18),
			Color3.fromRGB(12, 13, 16),
			Enum.Material.SmoothPlastic
		)

		rotor.CFrame =
			motor.CFrame

		weld(motor, rotor)

		table.insert(rotors, rotor)

		-- zweites Rotorblatt
		local rotor2 = makePart(
			drone,
			"RotorBlade_" .. i,
			Vector3.new(0.18, 0.06, 2.25),
			Color3.fromRGB(12, 13, 16),
			Enum.Material.SmoothPlastic
		)

		rotor2.CFrame =
			motor.CFrame

		weld(motor, rotor2)

		table.insert(rotors, rotor2)

	end

	--==========================================================
	-- LEDS
	--==========================================================

	local ledPositions = {
		Vector3.new(-1.25, 0.1, -1.4),
		Vector3.new(1.25, 0.1, -1.4),
		Vector3.new(-1.25, 0.1, 1.4),
		Vector3.new(1.25, 0.1, 1.4)
	}

	for i, offset in ipairs(ledPositions) do

		local led = makePart(
			drone,
			"LED_" .. i,
			Vector3.new(0.55, 0.1, 0.15),
			Color3.fromRGB(0, 190, 255),
			Enum.Material.Neon
		)

		led.CFrame =
			core.CFrame *
			CFrame.new(offset)

		weld(core, led)

		table.insert(leds, led)

	end

	--==========================================================
	-- BOOST THRUSTERS
	--==========================================================

	for _, offset in ipairs({
		Vector3.new(-1.0, -0.45, 0),
		Vector3.new(1.0, -0.45, 0)
	}) do

		local thruster = makePart(
			drone,
			"Thruster",
			Vector3.new(0.45, 0.18, 0.45),
			Color3.fromRGB(20, 100, 255),
			Enum.Material.Neon
		)

		thruster.CFrame =
			core.CFrame *
			CFrame.new(offset)

		weld(core, thruster)

		table.insert(thrusters, thruster)

	end

	--==========================================================
	-- TRAINING LASER
	--==========================================================

	local laserEmitter = makePart(
		drone,
		"TrainingEmitter",
		Vector3.new(0.5, 0.3, 0.65),
		Color3.fromRGB(30, 30, 35),
		Enum.Material.Metal
	)

	laserEmitter.CFrame =
		core.CFrame *
		CFrame.new(
			0,
			-0.25,
			-1.9
		)

	weld(core, laserEmitter)

	local emitterLight =
		createLight(
			laserEmitter,
			Color3.fromRGB(255, 45, 45),
			5,
			1
		)

	--==========================================================
	-- PHYSICS
	--==========================================================

	local attachment =
		Instance.new("Attachment")

	attachment.Parent = core

	velocityController =
		Instance.new("LinearVelocity")

	velocityController.Attachment0 =
		attachment

	velocityController.MaxForce =
		math.huge

	velocityController.RelativeTo =
		Enum.ActuatorRelativeTo.World

	velocityController.VectorVelocity =
		Vector3.zero

	velocityController.Parent =
		core

	angularController =
		Instance.new("AngularVelocity")

	angularController.Attachment0 =
		attachment

	angularController.MaxTorque =
		math.huge

	angularController.RelativeTo =
		Enum.ActuatorRelativeTo.World

	angularController.AngularVelocity =
		Vector3.zero

	angularController.Parent =
		core

	return drone
end

--==============================================================
-- START
--==============================================================

local function startDrone()

	if flying then
		return
	end

	flying = true

	local character = player.Character
	local root =
		character and
		character:FindFirstChild("HumanoidRootPart")

	if root then
		yaw =
			math.atan2(
				-root.CFrame.LookVector.X,
				-root.CFrame.LookVector.Z
			)
	end

	cameraYaw = yaw
	cameraPitch = -0.15

	createDrone()

	camera.CameraType =
		Enum.CameraType.Scriptable

	UIS.MouseBehavior =
		Enum.MouseBehavior.LockCenter

	UIS.MouseIconEnabled = false

end

--==============================================================
-- STOP
--==============================================================

local function stopDrone()

	flying = false

	if drone then
		drone:Destroy()
	end

	drone = nil
	core = nil

	camera.CameraType =
		Enum.CameraType.Custom

	UIS.MouseBehavior =
		Enum.MouseBehavior.Default

	UIS.MouseIconEnabled = true

end

--==============================================================
-- INPUT
--==============================================================

UIS.InputBegan:Connect(function(input, processed)

	if processed then
		return
	end

	if input.KeyCode == Enum.KeyCode.W then
		keys.W = true

	elseif input.KeyCode == Enum.KeyCode.S then
		keys.S = true

	elseif input.KeyCode == Enum.KeyCode.A then
		keys.A = true

	elseif input.KeyCode == Enum.KeyCode.D then
		keys.D = true

	elseif input.KeyCode == Enum.KeyCode.Space then
		keys.Up = true

	elseif input.KeyCode == Enum.KeyCode.LeftControl then
		keys.Down = true

	elseif input.KeyCode == Enum.KeyCode.LeftShift then
		keys.Boost = true

	elseif input.KeyCode == Enum.KeyCode.F then
		firing = true

	elseif input.KeyCode == Enum.KeyCode.Q then
		stopDrone()

	elseif input.KeyCode == Enum.KeyCode.R then

		if not flying then
			startDrone()
		end

	end

end)

UIS.InputEnded:Connect(function(input)

	if input.KeyCode == Enum.KeyCode.W then
		keys.W = false

	elseif input.KeyCode == Enum.KeyCode.S then
		keys.S = false

	elseif input.KeyCode == Enum.KeyCode.A then
		keys.A = false

	elseif input.KeyCode == Enum.KeyCode.D then
		keys.D = false

	elseif input.KeyCode == Enum.KeyCode.Space then
		keys.Up = false

	elseif input.KeyCode == Enum.KeyCode.LeftControl then
		keys.Down = false

	elseif input.KeyCode == Enum.KeyCode.LeftShift then
		keys.Boost = false

	elseif input.KeyCode == Enum.KeyCode.F then
		firing = false

	end

end)

--==============================================================
-- FREE CAMERA
--==============================================================

UIS.InputChanged:Connect(function(input)

	if not flying then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement then

		cameraYaw -=
			input.Delta.X *
			MOUSE_SENSITIVITY

		cameraPitch -=
			input.Delta.Y *
			MOUSE_SENSITIVITY

		cameraPitch =
			math.clamp(
				cameraPitch,
				-1.15,
				0.9
			)

	end

end)

--==============================================================
-- TRAINING LASER
--==============================================================

local lastShot = 0
local shotCooldown = 0.12

local function fireTrainingLaser()

	if not core then
		return
	end

	local now = os.clock()

	if now - lastShot < shotCooldown then
		return
	end

	lastShot = now

	-- Mündungsposition
	local origin =
		core.Position +
		core.CFrame.LookVector * -1.9 +
		Vector3.new(0, -0.25, 0)

	local direction =
		core.CFrame.LookVector * -350

	-- Laser-Effekt
	local distance = 350

	local beam =
		Instance.new("Part")

	beam.Name =
		"TrainingLaser"

	beam.Anchored = true
	beam.CanCollide = false
	beam.CanTouch = false
	beam.CanQuery = false

	beam.Material =
		Enum.Material.Neon

	beam.Color =
		Color3.fromRGB(
			255,
			45,
			55
		)

	beam.Size =
		Vector3.new(
			0.08,
			0.08,
			distance
		)

	beam.CFrame =
		CFrame.lookAt(
			origin,
			origin + direction
		) *
		CFrame.new(
			0,
			0,
			-distance/2
		)

	beam.Parent =
		workspace

	Debris:AddItem(
		beam,
		0.055
	)

	--==========================================================
	-- MUZZLE FLASH
	--==========================================================

	local flash =
		Instance.new("Part")

	flash.Anchored = true
	flash.CanCollide = false
	flash.CanTouch = false
	flash.CanQuery = false

	flash.Shape =
		Enum.PartType.Ball

	flash.Size =
		Vector3.new(
			0.9,
			0.9,
			0.9
		)

	flash.Material =
		Enum.Material.Neon

	flash.Color =
		Color3.fromRGB(
			255,
			180,
			60
		)

	flash.CFrame =
		CFrame.new(
			origin
		)

	flash.Parent =
		workspace

	Debris:AddItem(
		flash,
		0.07
	)

	--==========================================================
	-- RECOIL
	--==========================================================

	core.AssemblyLinearVelocity +=
		-core.CFrame.LookVector * 2

end

--==============================================================
-- DRONE ANIMATION
--==============================================================

local rotorAngle = 0
local hoverTime = 0

local function animateDrone(dt)

	if not flying or not core then
		return
	end

	hoverTime += dt

	--==========================================================
	-- ROTORS
	--==========================================================

	rotorAngle +=
		dt *
		(
			keys.Boost
			and 55
			or 35
		)

	for i, rotor in ipairs(rotors) do

		if rotor and rotor.Parent then

			local angle =
				rotorAngle *
				(i % 2 == 0 and -1 or 1)

			rotor.CFrame =
				rotor.CFrame *
				CFrame.Angles(
					0,
					angle,
					0
				)

		end

	end

	--==========================================================
	-- LED ANIMATION
	--==========================================================

	local pulse =
		(
			math.sin(
				hoverTime * 6
			) + 1
		) / 2

	for i, led in ipairs(leds) do

		if led and led.Parent then

			if i % 2 == 0 then

				led.Color =
					Color3.fromRGB(
						0,
						100 + pulse * 155,
						255
					)

			else

				led.Color =
					Color3.fromRGB(
						255,
						40 + pulse * 100,
						60
					)

			end

		end

	end

	--==========================================================
	-- BOOST EFFECT
	--==========================================================

	for _, thruster in ipairs(thrusters) do

		if keys.Boost then

			thruster.Color =
				Color3.fromRGB(
					60,
					170,
					255
				)

		else

			thruster.Color =
				Color3.fromRGB(
					20,
					70,
					130
				)

		end

	end

end

--==============================================================
-- FLIGHT PHYSICS
--==============================================================

local function updateFlight(dt)

	if not flying then
		return
	end

	if not core then
		return
	end

	local movement =
		Vector3.zero

	if keys.W then
		movement += Vector3.new(0,0,-1)
	end

	if keys.S then
		movement += Vector3.new(0,0,1)
	end

	if keys.A then
		movement += Vector3.new(-1,0,0)
	end

	if keys.D then
		movement += Vector3.new(1,0,0)
	end

	if keys.Up then
		movement += Vector3.new(0,1,0)
	end

	if keys.Down then
		movement += Vector3.new(0,-1,0)
	end

	if movement.Magnitude > 0 then
		movement = movement.Unit
	end

	--==========================================================
	-- CAMERA RELATIVE MOVEMENT
	--==========================================================

	local cameraCF =
		CFrame.Angles(
			0,
			cameraYaw,
			0
		)

	local horizontal =
		cameraCF:VectorToWorldSpace(
			Vector3.new(
				movement.X,
				0,
				movement.Z
			)
		)

	local vertical =
		movement.Y *
		VERTICAL_SPEED

	local maxSpeed =
		keys.Boost
		and BOOST_SPEED
		or NORMAL_SPEED

	local targetVelocity =
		horizontal * maxSpeed

	targetVelocity =
		Vector3.new(
			targetVelocity.X,
			vertical,
			targetVelocity.Z
		)

	currentVelocity =
		currentVelocity:Lerp(
			targetVelocity,
			math.clamp(
				dt * 5,
				0,
				1
			)
		)

	velocityController.VectorVelocity =
		currentVelocity

	--==========================================================
	-- DRONE YAW
	--==========================================================

	local targetYaw =
		cameraYaw

	yaw +=
		(targetYaw - yaw) *
		math.clamp(
			dt * 5,
			0,
			1
		)

	--==========================================================
	-- TILT
	--==========================================================

	local forwardInput = 0
	local sideInput = 0

	if keys.W then
		forwardInput = 1
	elseif keys.S then
		forwardInput = -1
	end

	if keys.A then
		sideInput = -1
	elseif keys.D then
		sideInput = 1
	end

	local pitchTilt =
		math.rad(
			-12 *
			forwardInput
		)

	local rollTilt =
		math.rad(
			-15 *
			sideInput
		)

	local targetCF =
		CFrame.new(
			core.Position
		) *
		CFrame.Angles(
			pitchTilt,
			yaw,
			rollTilt
		)

	-- Rotation sanft simulieren
	local targetLook =
		targetCF.LookVector

	local desiredAngular =
		Vector3.new(
			0,
			(yaw -
				core.Orientation.Y *
				math.pi / 180) * 4,
			0
		)

	angularController.AngularVelocity =
		desiredAngular

end

--==============================================================
-- CAMERA UPDATE
--==============================================================

local function updateCamera(dt)

	if not flying or not core then
		return
	end

	local rotation =
		CFrame.Angles(
			0,
			cameraYaw,
			0
		) *
		CFrame.Angles(
			cameraPitch,
			0,
			0
		)

	local cameraDirection =
		rotation.LookVector

	local cameraPosition =
		core.Position
		- cameraDirection * CAMERA_DISTANCE
		+ Vector3.new(
			0,
			CAMERA_HEIGHT,
			0
		)

	local target =
		core.Position +
		cameraDirection * 8

	local wanted =
		CFrame.lookAt(
			cameraPosition,
			target
		)

	camera.CFrame =
		camera.CFrame:Lerp(
			wanted,
			math.clamp(
				dt * CAMERA_SMOOTH,
				0,
				1
			)
		)

end

--==============================================================
-- MAIN LOOP
--==============================================================

startDrone()

RunService.RenderStepped:Connect(function(dt)

	if not flying then
		return
	end

	updateFlight(dt)
	updateCamera(dt)
	animateDrone(dt)

	if firing then
		fireTrainingLaser()
	end

end)
