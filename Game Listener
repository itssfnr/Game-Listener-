local function CreateBike(cfg)

	local model = Instance.new("Model")
	model.Name = cfg.Name
	model.Parent = VehiclesFolder

	local frame = childPart(
		model,
		"Frame",
		Vector3.new(
			2,
			1.2,
			5.8
		),
		CFrame.new(
			WORLD_POS.X,
			WORLD_POS.Y+20,
			WORLD_POS.Z
		),
		cfg.Color,
		Enum.Material.Metal
	)

	model.PrimaryPart = frame

	-- wheels

	for _,data in ipairs({
		{"FrontWheel",3.0},
		{"RearWheel",-3.0}
	}) do

		local wheel = Instance.new("Part")

		wheel.Name = data[1]
		wheel.Shape = Enum.PartType.Cylinder

		wheel.Size =
			Vector3.new(
				1.05,
				cfg.Wheel*2,
				cfg.Wheel*2
			)

		wheel.Color = Color3.fromRGB(7,7,9)
		wheel.Material = Enum.Material.Rubber

		wheel.CanCollide = false
		wheel.CanTouch = false
		wheel.Massless = true

		wheel.CFrame =
			frame.CFrame *
			CFrame.new(
				0,
				-.65,
				data[2]
			) *
			CFrame.Angles(
				0,
				0,
				math.rad(90)
			)

		wheel.Parent = model

		weld(frame,wheel)

	end

	-- tank

	local tank = childPart(
		model,
		"Tank",
		Vector3.new(
			2.2,
			1.5,
			2.4
		),
		frame.CFrame *
		CFrame.new(
			0,
			.9,
			.35
		),
		cfg.Color,
		Enum.Material.SmoothPlastic
	)

	weld(frame,tank)

	-- seat

	local seat = Instance.new("VehicleSeat")

	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(1.8,.45,1.8)

	seat.CFrame =
		frame.CFrame *
		CFrame.new(
			0,
			1.25,
			-1.1
		)

	seat.MaxSpeed = cfg.Speed
	seat.Torque = cfg.Acceleration*700
	seat.TurnSpeed = cfg.Steering

	seat.CanCollide = false
	seat.CanTouch = false

	seat.Parent = model

	weld(frame,seat)

	-- handlebars

	local bars = childPart(
		model,
		"Handlebars",
		Vector3.new(
			3,
			.18,
			.18
		),
		frame.CFrame *
		CFrame.new(
			0,
			1.9,
			2.35
		),
		cfg.Accent,
		Enum.Material.Metal
	)

	weld(frame,bars)

	-- front fairing

	local fairing = childPart(
		model,
		"Fairing",
		Vector3.new(
			1.9,
			1.7,
			1.6
		),
		frame.CFrame *
		CFrame.new(
			0,
			.75,
			2.25
		),
		cfg.Color,
		Enum.Material.SmoothPlastic
	)

	weld(frame,fairing)

	-- headlight

	local lamp = light(
		model,
		"Headlight",
		Vector3.new(
			.8,
			.65,
			.25
		),
		frame.CFrame *
		CFrame.new(
			0,
			.95,
			3.05
		),
		Color3.fromRGB(
			255,
			245,
			200
		)
	)

	weld(frame,lamp)

	return model
end

--==============================================================
-- DESTROY VEHICLE
--==============================================================

local function RemoveActiveVehicle()

	if activeVehicle then
		activeVehicle:Destroy()
	end

	activeVehicle = nil
	activeBody = nil
	activeSeat = nil
	driving = false

end

--==============================================================
-- CREATE SELECTED VEHICLE
--==============================================================

local function BuildVehicle(cfg)

	RemoveActiveVehicle()

	local model

	if cfg.Type == "Motorcycle" then
		model = CreateBike(cfg)
	else
		model = CreateCar(cfg)
	end

	activeVehicle = model
	activeBody = model.PrimaryPart
	activeSeat = model:FindFirstChild("DriverSeat")

	-- Put it into spawn position

	local spawnCF =
		CFrame.new(
			WORLD_POS.X-350,
			WORLD_POS.Y+18,
			WORLD_POS.Z
		)

	model:PivotTo(spawnCF)

	-- local network ownership

	for _,obj in ipairs(model:GetDescendants()) do

		if obj:IsA("BasePart") then

			pcall(function()
				obj:SetNetworkOwner(player)
			end)

		end

	end

	return model
end

--==============================================================
-- DRIVE
--==============================================================

local function StartDriving()

	if not selectedConfig then
		return
	end

	local model = BuildVehicle(selectedConfig)

	if not model then
		return
	end

	driving = true
	garageOpen = false

	-- hide garage

	local garage = playerGui:FindFirstChild("NeonMotorsGUI")

	if garage then
		local main = garage:FindFirstChild("Main")
		if main then
			main.Visible = false
		end
	end

	-- seat player

	task.wait(.25)

	local character = player.Character

	if character and activeSeat then

		local humanoid =
			character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			activeSeat:Sit(humanoid)
		end

	end

	-- camera

	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom

end

--==============================================================
-- RESET
--==============================================================

local function ResetVehicle()

	if not activeVehicle or not activeBody then
		return
	end

	activeVehicle:PivotTo(
		CFrame.new(
			WORLD_POS.X-350,
			WORLD_POS.Y+18,
			WORLD_POS.Z
		)
	)

	activeBody.AssemblyLinearVelocity = Vector3.zero
	activeBody.AssemblyAngularVelocity = Vector3.zero

end

