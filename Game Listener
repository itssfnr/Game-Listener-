local function CreateCar(cfg)

	local model = Instance.new("Model")
	model.Name = cfg.Name
	model.Parent = VehiclesFolder

	local chassis = childPart(
		model,
		"Chassis",
		Vector3.new(
			cfg.Width,
			cfg.Height,
			cfg.Length
		),
		CFrame.new(
			WORLD_POS.X,
			WORLD_POS.Y+20,
			WORLD_POS.Z
		),
		cfg.Color,
		Enum.Material.Metal
	)

	model.PrimaryPart = chassis

	chassis.CustomPhysicalProperties =
		PhysicalProperties.new(
			1,
			0.8,
			0.05,
			1,
			1
		)

	-- lower side skirts

	for _,x in ipairs({
		-cfg.Width*.48,
		cfg.Width*.48
	}) do

		local skirt = childPart(
			model,
			"SideSkirt",
			Vector3.new(
				.3,
				cfg.Height*.55,
				cfg.Length*.65
			),
			chassis.CFrame *
			CFrame.new(
				x,
				-.05,
				0
			),
			cfg.Accent,
			Enum.Material.SmoothPlastic
		)

		weld(chassis,skirt)

	end

	-- hood

	local hood = childPart(
		model,
		"Hood",
		Vector3.new(
			cfg.Width*.82,
			cfg.Height*.42,
			cfg.Length*.30
		),
		chassis.CFrame *
		CFrame.new(
			0,
			cfg.Height*.47,
			cfg.Length*.32
		),
		cfg.Color,
		Enum.Material.SmoothPlastic
	)

	weld(chassis,hood)

	-- roof

	local roof = childPart(
		model,
		"Roof",
		Vector3.new(
			cfg.Width*.66,
			cfg.Height*.8,
			cfg.Length*.40
		),
		chassis.CFrame *
		CFrame.new(
			0,
			cfg.Height*.75,
			-.35
		),
		cfg.Accent,
		Enum.Material.SmoothPlastic
	)

	weld(chassis,roof)

	-- windshield

	local windshield = glass(
		model,
		"FrontGlass",
		Vector3.new(
			cfg.Width*.58,
			cfg.Height*.58,
			.12
		),
		roof.CFrame *
		CFrame.new(
			0,
			.05,
			cfg.Length*.20
		)
	)

	weld(roof,windshield)

	-- rear glass

	local rearGlass = glass(
		model,
		"RearGlass",
		Vector3.new(
			cfg.Width*.58,
			cfg.Height*.52,
			.12
		),
		roof.CFrame *
		CFrame.new(
			0,
			.05,
			-cfg.Length*.20
		)
	)

	weld(roof,rearGlass)

	-- side windows

	for _,x in ipairs({
		-cfg.Width*.335,
		cfg.Width*.335
	}) do

		local window = glass(
			model,
			"SideWindow",
			Vector3.new(
				.08,
				cfg.Height*.5,
				cfg.Length*.30
			),
			roof.CFrame *
			CFrame.new(
				x,
				.05,
				0
			)
		)

		weld(roof,window)

	end

	-- mirrors

	for _,x in ipairs({
		-cfg.Width*.52,
		cfg.Width*.52
	}) do

		local mirror = childPart(
			model,
			"Mirror",
			Vector3.new(
				.55,
				.35,
				.85
			),
			chassis.CFrame *
			CFrame.new(
				x,
				cfg.Height*.65,
				cfg.Length*.12
			),
			cfg.Accent,
			Enum.Material.Metal
		)

		weld(chassis,mirror)

	end

	-- wheels

	local wx = cfg.Width/2+.05
	local wz = cfg.Length*.31
	local wy = -cfg.Height*.42

	AddWheel(
		model,
		chassis,
		"FrontLeft",
		Vector3.new(-wx,wy,wz),
		cfg.Wheel
	)

	AddWheel(
		model,
		chassis,
		"FrontRight",
		Vector3.new(wx,wy,wz),
		cfg.Wheel
	)

	AddWheel(
		model,
		chassis,
		"RearLeft",
		Vector3.new(-wx,wy,-wz),
		cfg.Wheel
	)

	AddWheel(
		model,
		chassis,
		"RearRight",
		Vector3.new(wx,wy,-wz),
		cfg.Wheel
	)

	-- headlights

	for _,x in ipairs({
		-cfg.Width*.27,
		cfg.Width*.27
	}) do

		local h = light(
			model,
			"Headlight",
			Vector3.new(
				1.4,
				.48,
				.18
			),
			chassis.CFrame *
			CFrame.new(
				x,
				.05,
				cfg.Length/2+.05
			),
			Color3.fromRGB(
				255,
				245,
				205
			)
		)

		weld(chassis,h)

	end

	-- taillights

	for _,x in ipairs({
		-cfg.Width*.27,
		cfg.Width*.27
	}) do

		local h = light(
			model,
			"TailLight",
			Vector3.new(
				1.4,
				.48,
				.18
			),
			chassis.CFrame *
			CFrame.new(
				x,
				.05,
				-cfg.Length/2-.05
			),
			Color3.fromRGB(
				255,
				25,
				25
			)
		)

		weld(chassis,h)

	end

	-- front splitter

	local splitter = childPart(
		model,
		"Splitter",
		Vector3.new(
			cfg.Width*1.02,
			.25,
			1.0
		),
		chassis.CFrame *
		CFrame.new(
			0,
			-.35,
			cfg.Length/2+.25
		),
		cfg.Accent,
		Enum.Material.CarbonFiber
	)

	weld(chassis,splitter)

	-- rear diffuser

	local diffuser = childPart(
		model,
		"Diffuser",
		Vector3.new(
			cfg.Width*.88,
			.35,
			1
		),
		chassis.CFrame *
		CFrame.new(
			0,
			-.3,
			-cfg.Length/2-.2
		),
		cfg.Accent,
		Enum.Material.CarbonFiber
	)

	weld(chassis,diffuser)

	-- spoiler for sporty vehicles

	if cfg.Type == "Supercar"
	or cfg.Type == "Hypercar"
	or cfg.Type == "Race"
	or cfg.Type == "Sports" then

		local spoiler = childPart(
			model,
			"Spoiler",
			Vector3.new(
				cfg.Width*.92,
				.28,
				1.0
			),
			chassis.CFrame *
			CFrame.new(
				0,
				cfg.Height+1.1,
				-cfg.Length*.39
			),
			cfg.Accent,
			Enum.Material.Metal
		)

		weld(chassis,spoiler)

		for _,x in ipairs({
			-cfg.Width*.30,
			cfg.Width*.30
		}) do

			local support = childPart(
				model,
				"SpoilerSupport",
				Vector3.new(
					.22,
					1.15,
					.22
				),
				chassis.CFrame *
				CFrame.new(
					x,
					cfg.Height*.6,
					-cfg.Length*.39
				),
				cfg.Accent,
				Enum.Material.Metal
			)

			weld(chassis,support)

		end
	end

	-- seats

	local seat = Instance.new("VehicleSeat")

	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2.3,.6,2.2)

	seat.CFrame =
		chassis.CFrame *
		CFrame.new(
			0,
			cfg.Height+.55,
			-.65
		)

	seat.Color = Color3.fromRGB(20,20,22)
	seat.Material = Enum.Material.SmoothPlastic

	seat.MaxSpeed = cfg.Speed
	seat.Torque = cfg.Acceleration*800
	seat.TurnSpeed = cfg.Steering

	seat.CanCollide = false
	seat.CanTouch = false

	seat.Parent = model

	weld(chassis,seat)

	-- invisible mass below chassis

	local mass = childPart(
		model,
		"Mass",
		Vector3.new(
			2,
			.7,
			4
		),
		chassis.CFrame *
		CFrame.new(
			0,
			-.6,
			0
		),
		Color3.new(0,0,0),
		Enum.Material.Metal
	)

	mass.Transparency = 1
	mass.CanCollide = false
	mass.Massless = false

	weld(chassis,mass)

	return model
end

