local function BuildTrack()

	local base = part(
		Track,
		"Ground",
		Vector3.new(1500,20,1500),
		CFrame.new(WORLD_POS),
		Color3.fromRGB(58,60,63),
		Enum.Material.Concrete,
		true,
		true
	)

	local road = part(
		Track,
		"MainRoad",
		Vector3.new(1150,1,120),
		CFrame.new(
			WORLD_POS.X,
			WORLD_POS.Y + 10,
			WORLD_POS.Z
		),
		Color3.fromRGB(28,29,32),
		Enum.Material.Asphalt,
		true,
		true
	)

	local road2 = part(
		Track,
		"CrossRoad",
		Vector3.new(120,1,800),
		CFrame.new(
			WORLD_POS.X + 300,
			WORLD_POS.Y + 10,
			WORLD_POS.Z
		),
		Color3.fromRGB(28,29,32),
		Enum.Material.Asphalt,
		true,
		true
	)

	local drift = part(
		Track,
		"DriftZone",
		Vector3.new(420,1,420),
		CFrame.new(
			WORLD_POS.X - 330,
			WORLD_POS.Y + 10,
			WORLD_POS.Z + 270
		),
		Color3.fromRGB(34,35,38),
		Enum.Material.Asphalt,
		true,
		true
	)

	-- lane markers

	for i = -12,12 do
		part(
			Track,
			"Lane",
			Vector3.new(35,.12,2),
			CFrame.new(
				WORLD_POS.X + i*45,
				WORLD_POS.Y + 10.6,
				WORLD_POS.Z
			),
			Color3.fromRGB(235,235,205),
			Enum.Material.Neon,
			true,
			false
		)
	end

	-- drift ring

	for i = 1,36 do

		local a = math.rad(i*10)

		local x = math.cos(a)*145
		local z = math.sin(a)*145

		local mark = part(
			Track,
			"DriftMark",
			Vector3.new(25,.1,2),
			CFrame.new(
				WORLD_POS.X-330+x,
				WORLD_POS.Y+10.7,
				WORLD_POS.Z+270+z
			) *
			CFrame.Angles(
				0,
				-a,
				0
			),
			Color3.fromRGB(210,210,210),
			Enum.Material.Neon,
			true,
			false
		)
	end

	-- start grid

	for i=0,7 do

		local x = WORLD_POS.X - 150 + i*42

		part(
			Track,
			"Grid",
			Vector3.new(2,.15,80),
			CFrame.new(
				x,
				WORLD_POS.Y+10.8,
				WORLD_POS.Z
			),
			Color3.fromRGB(255,255,255),
			Enum.Material.Neon,
			true,
			false
		)
	end

	-- barriers

	for i=-8,8 do

		part(
			Track,
			"Barrier",
			Vector3.new(3,3,18),
			CFrame.new(
				WORLD_POS.X+i*55,
				WORLD_POS.Y+13,
				WORLD_POS.Z+65
			),
			Color3.fromRGB(220,35,35),
			Enum.Material.Metal,
			true,
			true
		)

	end

end

BuildTrack()

