local function CreateMotorcycle(cfg,position)

	local model =
		Instance.new("Model")

	model.Name =
		"Motorcycle"

	model.Parent =
		carsFolder

	local frame =
		MakePart(
			model,
			"Frame",
			Vector3.new(
				2.2,
				1.4,
				6
			),
			CFrame.new(position),
			cfg.color,
			Enum.Material.Metal,
			false
		)

	model.PrimaryPart =
		frame

	-- Wheels

	for _,data in ipairs({
		{
			name="FrontWheel",
			z=3.2
		},
		{
			name="RearWheel",
			z=-3.2
		}
	}) do

		local wheel =
			Instance.new("Part")

		wheel.Name =
			data.name

		wheel.Shape =
			Enum.PartType.Cylinder

		wheel.Size =
			Vector3.new(
				1.2,
				cfg.wheel*2,
				cfg.wheel*2
			)

		wheel.Color =
			Color3.fromRGB(
				10,
				10,
				12
			)

		wheel.Material =
			Enum.Material.Rubber

		wheel.CanCollide =
			false

		wheel.Massless =
			true

		wheel.CFrame =
			frame.CFrame *
			CFrame.new(
				0,
				-0.7,
				data.z
			) *
			CFrame.Angles(
				0,
				0,
				math.rad(90)
			)

		wheel.Parent =
			model

		Weld(frame,wheel)

	end

	-- Tank

	local tank =
		MakePart(
			model,
			"FuelTank",
			Vector3.new(
				2.2,
				1.4,
				2.5
			),
			frame.CFrame *
			CFrame.new(
				0,
				1,
				0.3
			),
			cfg.color,
			Enum.Material.SmoothPlastic,
			false
		)

	Weld(frame,tank)

	-- Seat

	local seat =
		Instance.new(
			"VehicleSeat"
		)

	seat.Name =
		"DriverSeat"

	seat.Size =
		Vector3.new(
			2,
			0.5,
			2
		)

	seat.CFrame =
		frame.CFrame *
		CFrame.new(
			0,
			1.25,
			-1.2
		)

	seat.MaxSpeed =
		cfg.speed

	seat.Torque =
		cfg.accel*800

	seat.TurnSpeed =
		cfg.turn

	seat.Parent =
		model

	Weld(frame,seat)

	-- Handlebar

	local handle =
		MakePart(
			model,
			"Handlebar",
			Vector3.new(
				3.1,
				0.18,
				0.2
			),
			frame.CFrame *
			CFrame.new(
				0,
				2,
				2.25
			),
			cfg.dark,
			Enum.Material.Metal,
			false
		)

	Weld(frame,handle)

	-- Headlight

	local light =
		MakePart(
			model,
			"Headlight",
			Vector3.new(
				1.1,
				0.8,
				0.4
			),
			frame.CFrame *
			CFrame.new(
				0,
				1.25,
				3.25
			),
			Color3.fromRGB(
				255,
				245,
				190
			),
			Enum.Material.Neon,
			false
		)

	Weld(frame,light)

	return model
end

--==============================================================
-- SPAWN VEHICLE
--==============================================================

local function SpawnVehicle(name)

	if currentCar then
		currentCar:Destroy()
		currentCar = nil
	end

	local cfg =
		Cars[name]

	if not cfg then
		return
	end

	local spawn =
		Vector3.new(
			WORLD.X - 400,
			WORLD.Y + 18,
			WORLD.Z - 250
		)

	if name == "Motorcycle" then

		currentCar =
			CreateMotorcycle(
				cfg,
				spawn
			)

	else

		currentCar =
			CreateCarBody(
				name,
				cfg,
				spawn
			)

	end

	currentConfig =
		cfg

	-- Give local physics ownership

	for _,obj in ipairs(currentCar:GetDescendants()) do

		if obj:IsA("BasePart") then
			obj:SetNetworkOwner(player)
		end

	end

	local seat =
		currentCar:FindFirstChild(
			"DriverSeat"
		)

	if seat then

		local character =
			player.Character

		if character then

			local humanoid =
				character:FindFirstChildOfClass(
					"Humanoid"
				)

			if humanoid then

				task.wait(0.15)

				seat:Sit(humanoid)

			end

		end

	end

	driving = true
end

