--==============================================================
-- CREATE WHEEL
--==============================================================

local function createWheel(
	car,
	body,
	name,
	position,
	radius
)

	local wheel =
		Instance.new("Part")

	wheel.Name =
		name

	wheel.Shape =
		Enum.PartType.Cylinder

	wheel.Size =
		Vector3.new(
			radius * 2,
			1.2,
			radius * 2
		)

	wheel.Color =
		Color3.fromRGB(
			15,
			15,
			17
		)

	wheel.Material =
		Enum.Material.Rubber

	wheel.CanCollide =
		false

	wheel.CFrame =
		body.CFrame *
		CFrame.new(
			position
		) *
		CFrame.Angles(
			0,
			0,
			math.rad(90)
		)

	wheel.Parent =
		car

	return wheel
end

