--==================================================
-- SPAWN PLAYER
--==================================================

local function teleportPlayer()
	local character = player.Character or player.CharacterAdded:Wait()
	local root = character:WaitForChild("HumanoidRootPart")

	root.CFrame = CFrame.new(0, 6, 0)
end

player.CharacterAdded:Connect(function()
	task.wait(0.5)
	teleportPlayer()
end)

if player.Character then
	task.wait(0.5)
	teleportPlayer()
end

--==================================================
-- CAR CREATION
--==================================================

local function createCar()
	local car = Instance.new("Model")
	car.Name = "ClassicCar"
	car.Parent = world

	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(7, 1.5, 11)
	body.Position = Vector3.new(0, 3, -18)
	body.Color = Color3.fromRGB(200, 30, 30)
	body.Material = Enum.Material.SmoothPlastic
	body.Anchored = true
	body.Parent = car

	local cabin = Instance.new("Part")
	cabin.Name = "Cabin"
	cabin.Size = Vector3.new(5.5, 2.2, 5)
	cabin.Position = Vector3.new(0, 4.7, -18)
	cabin.Color = Color3.fromRGB(40, 40, 45)
	cabin.Material = Enum.Material.SmoothPlastic
	cabin.Anchored = true
	cabin.Parent = car

	-- Wheels
	local wheelPositions = {
		Vector3.new(-4, 2.3, -21),
		Vector3.new(4, 2.3, -21),
		Vector3.new(-4, 2.3, -15),
		Vector3.new(4, 2.3, -15)
	}

	for i, pos in ipairs(wheelPositions) do
		local wheel = Instance.new("Part")
		wheel.Name = "Wheel" .. i
		wheel.Shape = Enum.PartType.Cylinder
		wheel.Size = Vector3.new(2, 1, 2)
		wheel.Position = pos
		wheel.Orientation = Vector3.new(0, 0, 90)
		wheel.Color = Color3.fromRGB(20, 20, 20)
		wheel.Material = Enum.Material.Rubber
		wheel.Anchored = true
		wheel.Parent = car
	end

	-- Driver seat
	local seat = Instance.new("Seat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(3, 1, 3)
	seat.Position = Vector3.new(0, 3.8, -18)
	seat.Color = Color3.fromRGB(30, 30, 30)
	seat.Anchored = true
	seat.Parent = car

	-- Car controller
	local driving = false
	local speed = 0
	local rotation = 0

	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		driving = seat.Occupant ~= nil
	end)

	RunService.RenderStepped:Connect(function(dt)
		if not driving then
			return
		end

		local forward = 0
		local turn = 0

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			forward += 1
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			forward -= 1
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			turn -= 1
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			turn += 1
		end

		speed = forward * 45

		rotation = rotation + turn * 1.8 * dt

		local current = body.CFrame

		current =
			current
			* CFrame.Angles(0, -turn * 0.8 * dt, 0)
			+ current.LookVector * speed * dt

		-- Keep car on the baseplate
		current = CFrame.new(
			current.Position.X,
			3,
			current.Position.Z
		) * CFrame.Angles(
			0,
			current:ToEulerAnglesYXZ(),
			0
		)

		body.CFrame = current

		-- Move the other car parts with the body
		local bodyCF = body.CFrame

		cabin.CFrame =
			bodyCF * CFrame.new(0, 1.8, 0)

		seat.CFrame =
			bodyCF * CFrame.new(0, 0.8, 0)

		local offsets = {
			Vector3.new(-4, -0.7, -3),
			Vector3.new(4, -0.7, -3),
			Vector3.new(-4, -0.7, 3),
			Vector3.new(4, -0.7, 3)
		}

		for i, offset in ipairs(offsets) do
			local wheel = car:FindFirstChild("Wheel" .. i)

			if wheel then
				wheel.CFrame =
					bodyCF
					* CFrame.new(offset)
					* CFrame.Angles(0, 0, math.rad(90))
			end
		end
	end)

	return car
end

local car = createCar()

