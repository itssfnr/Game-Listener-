--// Roblox Universal Action Logger + Replay
--// Ein einziges Script in ServerScriptService
--// Alle Spieler können das Log sehen und erlaubte Aktionen wiederholen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

----------------------------------------------------------------
-- EINSTELLUNGEN
----------------------------------------------------------------

local MAX_LOGS = 200
local GUI_TITLE = "Action Logger"

----------------------------------------------------------------
-- REMOTE
----------------------------------------------------------------

local remote = ReplicatedStorage:FindFirstChild("ActionLoggerRemote")

if not remote then
	remote = Instance.new("RemoteEvent")
	remote.Name = "ActionLoggerRemote"
	remote.Parent = ReplicatedStorage
end

----------------------------------------------------------------
-- DATEN
----------------------------------------------------------------

local logs = {}
local nextId = 0

-- Hier werden Aktionen hinterlegt, die tatsächlich wiederholt
-- werden dürfen.
local replayActions = {}

----------------------------------------------------------------
-- HILFSFUNKTIONEN
----------------------------------------------------------------

local function safeString(value)
	if value == nil then
		return "nil"
	end

	if typeof(value) == "Instance" then
		return value:GetFullName()
	end

	if typeof(value) == "Vector3" then
		return string.format(
			"Vector3(%.1f, %.1f, %.1f)",
			value.X,
			value.Y,
			value.Z
		)
	end

	if typeof(value) == "CFrame" then
		local p = value.Position

		return string.format(
			"CFrame(%.1f, %.1f, %.1f)",
			p.X,
			p.Y,
			p.Z
		)
	end

	return tostring(value)
end

local function addLog(player, actionName, actionType, data, replayable)
	nextId += 1

	local entry = {
		Id = nextId,
		Time = os.date("%H:%M:%S"),
		Timestamp = os.time(),

		Player = player and player.Name or "SERVER",
		UserId = player and player.UserId or 0,

		Action = actionName or "Unknown",
		Type = actionType or "SERVER",

		Data = data or {},
		Replayable = replayable == true,
	}

	table.insert(logs, entry)

	if #logs > MAX_LOGS then
		table.remove(logs, 1)
	end

	-- Alle Spieler bekommen das neue Log.
	remote:FireAllClients("ADD", entry)

	return entry
end

----------------------------------------------------------------
-- ÖFFENTLICHE AKTIONSFUNKTION
----------------------------------------------------------------
-- Andere Systeme können Aktionen damit registrieren.
--
-- Beispiel:
--
-- ActionLogger(player, "DoorOpen", "PLAYER", {
--     Door = "MainDoor"
-- }, function(player, data)
--     print(player.Name, "öffnet die Tür erneut")
-- end)
--
-- Das Replay wird automatisch gespeichert.

local function ActionLogger(player, actionName, actionType, data, replayFunction)

	local replayable = typeof(replayFunction) == "function"

	if replayable then
		replayActions[actionName] = replayFunction
	end

	return addLog(
		player,
		actionName,
		actionType,
		data,
		replayable
	)
end

----------------------------------------------------------------
-- BEISPIEL-AKTIONEN
----------------------------------------------------------------
-- Diese zeigen, wie das System funktioniert.
-- Du kannst diese später durch deine eigenen Aktionen ersetzen.

local function registerPlayerActions(player)

	-- Beispiel: Spieler joint
	ActionLogger(
		player,
		"PlayerJoined",
		"PLAYER",
		{
			UserId = player.UserId
		},
		nil
	)

	-- Charakter Spawn
	player.CharacterAdded:Connect(function(character)

		local root = character:WaitForChild(
			"HumanoidRootPart",
			5
		)

		if root then

			ActionLogger(
				player,
				"CharacterSpawned",
				"PLAYER",
				{
					Position = safeString(root.Position)
				},
				function(replayPlayer, data)

					if replayPlayer
						and replayPlayer.Character
						and replayPlayer.Character:FindFirstChild("HumanoidRootPart")
					then

						-- Beispiel-Replay:
						-- Spieler wird an die gespeicherte Position teleportiert.

						local position = root.Position

						replayPlayer.Character.HumanoidRootPart.CFrame =
							CFrame.new(position)
					end
				end
			)

		end
	end)
end

----------------------------------------------------------------
-- SPIELER
----------------------------------------------------------------

Players.PlayerAdded:Connect(function(player)

	registerPlayerActions(player)

	-- Bereits vorhandene Logs an den neuen Spieler senden.
	task.defer(function()

		for _, entry in ipairs(logs) do
			remote:FireClient(player, "ADD", entry)
		end

	end)

end)

Players.PlayerRemoving:Connect(function(player)

	ActionLogger(
		player,
		"PlayerLeft",
		"PLAYER",
		{
			UserId = player.UserId
		},
		nil
	)

end)

----------------------------------------------------------------
-- CLIENT -> SERVER
----------------------------------------------------------------

remote.OnServerEvent:Connect(function(player, command, data)

	------------------------------------------------------------
	-- CLIENT MELDET EINE AKTION
	------------------------------------------------------------

	if command == "LOG" then

		if typeof(data) ~= "table" then
			return
		end

		local actionName = tostring(data.Action or "Unknown")

		-- Clientdaten begrenzen.
		local safeData = {}

		for key, value in pairs(data) do

			if key ~= "Action" then

				if typeof(value) ~= "Instance"
					and typeof(value) ~= "function"
					and typeof(value) ~= "thread"
				then

					safeData[tostring(key)] =
						safeString(value)

				end

			end

		end

		ActionLogger(
			player,
			actionName,
			"PLAYER",
			safeData,
			nil
		)

	------------------------------------------------------------
	-- REPLAY
	------------------------------------------------------------

	elseif command == "REPLAY" then

		local id = tonumber(data)

		if not id then
			return
		end

		local selected

		for _, entry in ipairs(logs) do

			if entry.Id == id then
				selected = entry
				break
			end

		end

		if not selected then
			return
		end

		if not selected.Replayable then

			remote:FireClient(
				player,
				"ERROR",
				"Diese Aktion kann nicht wiederholt werden."
			)

			return
		end

		local replayFunction =
			replayActions[selected.Action]

		if typeof(replayFunction) ~= "function" then

			remote:FireClient(
				player,
				"ERROR",
				"Für diese Aktion existiert kein Replay."
			)

			return
		end

		local success, errorMessage =
			pcall(function()

				replayFunction(
					player,
					selected.Data
				)

			end)

		if success then

			ActionLogger(
				player,
				"Replay: " .. selected.Action,
				"REPLAY",
				{
					OriginalId = selected.Id
				},
				nil
			)

		else

			warn(
				"[ActionLogger] Replay Fehler:",
				errorMessage
			)

			remote:FireClient(
				player,
				"ERROR",
				"Replay fehlgeschlagen."
			)

		end

	end

end)

----------------------------------------------------------------
-- GUI
----------------------------------------------------------------

local function createGui(player)

	local playerGui = player:WaitForChild("PlayerGui")

	local old = playerGui:FindFirstChild("ActionLoggerGui")

	if old then
		old:Destroy()
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "ActionLoggerGui"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui

	------------------------------------------------------------
	-- HAUPTFENSTER
	------------------------------------------------------------

	local main = Instance.new("Frame")
	main.Name = "Main"
	main.Size = UDim2.new(0, 700, 0, 500)
	main.Position = UDim2.new(0.5, -350, 0.5, -250)
	main.BackgroundColor3 = Color3.fromRGB(22, 24, 30)
	main.BorderSizePixel = 0
	main.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = main

	------------------------------------------------------------
	-- TITEL
	------------------------------------------------------------

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -30, 0, 45)
	title.Position = UDim2.new(0, 15, 0, 10)
	title.BackgroundTransparency = 1
	title.Text = GUI_TITLE
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 22
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = main

	------------------------------------------------------------
	-- SUCHFELD
	------------------------------------------------------------

	local search = Instance.new("TextBox")
	search.Size = UDim2.new(1, -30, 0, 36)
	search.Position = UDim2.new(0, 15, 0, 58)
	search.BackgroundColor3 = Color3.fromRGB(32, 35, 43)
	search.BorderSizePixel = 0
	search.PlaceholderText = "Aktion oder Spieler suchen..."
	search.PlaceholderColor3 = Color3.fromRGB(130, 135, 145)
	search.Text = ""
	search.TextColor3 = Color3.fromRGB(255, 255, 255)
	search.Font = Enum.Font.Gotham
	search.TextSize = 14
	search.Parent = main

	local searchCorner = Instance.new("UICorner")
	searchCorner.CornerRadius = UDim.new(0, 8)
	searchCorner.Parent = search

	------------------------------------------------------------
	-- SCROLL
	------------------------------------------------------------

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Log"
	scroll.Size = UDim2.new(1, -30, 1, -115)
	scroll.Position = UDim2.new(0, 15, 0, 105)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.Parent = main

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroll

	------------------------------------------------------------
	-- LOG-EINTRAG
	------------------------------------------------------------

	local function addEntry(entry)

		local textSearch =
			string.lower(
				(entry.Player or "") ..
				" " ..
				(entry.Action or "") ..
				" " ..
				(entry.Type or "")
			)

		local filter =
			string.lower(search.Text)

		if filter ~= ""
			and not string.find(textSearch, filter, 1, true)
		then
			return
		end

		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -8, 0, 62)
		row.BackgroundColor3 = Color3.fromRGB(30, 33, 41)
		row.BorderSizePixel = 0
		row.Parent = scroll

		local rowCorner = Instance.new("UICorner")
		rowCorner.CornerRadius = UDim.new(0, 8)
		rowCorner.Parent = row

		--------------------------------------------------------
		-- ZEIT
		--------------------------------------------------------

		local timeLabel = Instance.new("TextLabel")
		timeLabel.Size = UDim2.new(0, 70, 1, 0)
		timeLabel.Position = UDim2.new(0, 8, 0, 0)
		timeLabel.BackgroundTransparency = 1
		timeLabel.Text = entry.Time
		timeLabel.TextColor3 = Color3.fromRGB(145, 150, 160)
		timeLabel.Font = Enum.Font.Gotham
		timeLabel.TextSize = 12
		timeLabel.Parent = row

		--------------------------------------------------------
		-- AKTION
		--------------------------------------------------------

		local actionLabel = Instance.new("TextLabel")
		actionLabel.Size = UDim2.new(0.42, 0, 0, 24)
		actionLabel.Position = UDim2.new(0, 80, 0, 7)
		actionLabel.BackgroundTransparency = 1
		actionLabel.Text =
			"[" .. entry.Type .. "] " .. entry.Action
		actionLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		actionLabel.Font = Enum.Font.GothamBold
		actionLabel.TextSize = 14
		actionLabel.TextXAlignment = Enum.TextXAlignment.Left
		actionLabel.TextTruncate = Enum.TextTruncate.AtEnd
		actionLabel.Parent = row

		--------------------------------------------------------
		-- SPIELER
		--------------------------------------------------------

		local playerLabel = Instance.new("TextLabel")
		playerLabel.Size = UDim2.new(0.42, 0, 0, 20)
		playerLabel.Position = UDim2.new(0, 80, 0, 32)
		playerLabel.BackgroundTransparency = 1
		playerLabel.Text =
			"Spieler: " .. entry.Player
		playerLabel.TextColor3 = Color3.fromRGB(150, 155, 165)
		playerLabel.Font = Enum.Font.Gotham
		playerLabel.TextSize = 12
		playerLabel.TextXAlignment = Enum.TextXAlignment.Left
		playerLabel.TextTruncate = Enum.TextTruncate.AtEnd
		playerLabel.Parent = row

		--------------------------------------------------------
		-- AGAIN
		--------------------------------------------------------

		if entry.Replayable then

			local again = Instance.new("TextButton")
			again.Size = UDim2.new(0, 80, 0, 34)
			again.Position = UDim2.new(1, -90, 0.5, -17)
			again.BackgroundColor3 = Color3.fromRGB(55, 120, 255)
			again.BorderSizePixel = 0
			again.Text = "Again"
			again.TextColor3 = Color3.fromRGB(255, 255, 255)
			again.Font = Enum.Font.GothamBold
			again.TextSize = 13
			again.Parent = row

			local againCorner = Instance.new("UICorner")
			againCorner.CornerRadius = UDim.new(0, 7)
			againCorner.Parent = again

			again.MouseButton1Click:Connect(function()

				remote:FireServer(
					"REPLAY",
					entry.Id
				)

			end)

		end
	end

	------------------------------------------------------------
	-- ALLE BISHERIGEN LOGS
	------------------------------------------------------------

	for _, entry in ipairs(logs) do
		addEntry(entry)
	end

	------------------------------------------------------------
	-- NEUE LOGS
	------------------------------------------------------------

	local connection

	connection = remote.OnClientEvent:Connect(
		function(command, data)

			if command == "ADD" then

				addEntry(data)

				task.defer(function()
					scroll.CanvasPosition =
						Vector2.new(
							0,
							scroll.AbsoluteCanvasSize.Y
						)
				end)

			elseif command == "ERROR" then

				warn(
					"[ActionLogger]",
					data
				)

			end

		end
	)

	------------------------------------------------------------
	-- SUCHFILTER
	------------------------------------------------------------

	search:GetPropertyChangedSignal("Text"):Connect(function()

		for _, child in ipairs(scroll:GetChildren()) do

			if child:IsA("Frame") then
				child:Destroy()
			end

		end

		for _, entry in ipairs(logs) do
			addEntry(entry)
		end

	end)

end

----------------------------------------------------------------
-- GUI FÜR ALLE SPIELER
----------------------------------------------------------------

Players.PlayerAdded:Connect(function(player)

	task.defer(function()
		createGui(player)
	end)

end)

for _, player in ipairs(Players:GetPlayers()) do

	task.defer(function()
		createGui(player)
	end)

end

