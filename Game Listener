			),
			Enum.Material.Neon
		)

		Weld(chassis,lamp)

	end

	--==========================================================
	-- EXHAUST
	--==========================================================

	for _,x in ipairs({
		-cfg.width*0.25,
		cfg.width*0.25
	}) do

		local exhaust = MeshPart(
			model,
			"Exhaust",
			Vector3.new(
				0.45,
