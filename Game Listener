local function choose(number)

	local name =
		order[number]

	if name then

		spawnVehicle(
			name
		)

	end

end

UserInputService.InputBegan:Connect(
	function(
		input,
		processed
	)

		if processed then
			return
		end

		if input.KeyCode ==
			Enum.KeyCode.M then

			menu.Visible =
				not menu.Visible

		elseif input.KeyCode ==
			Enum.KeyCode.R then

			if currentVehicle
				and currentVehicle.PrimaryPart then

				currentVehicle.PrimaryPart.CFrame =
					CFrame.new(
						WORLD_POS.X - 300,
						5,
						WORLD_POS.Z
					)

				currentVehicle.PrimaryPart.AssemblyLinearVelocity =
					Vector3.zero

				currentVehicle.PrimaryPart.AssemblyAngularVelocity =
					Vector3.zero

			end

		elseif input.KeyCode ==
			Enum.KeyCode.One then

			choose(1)

		elseif input.KeyCode ==
			Enum.KeyCode.Two then

			choose(2)

		elseif input.KeyCode ==
			Enum.KeyCode.Three then

			choose(3)

		elseif input.KeyCode ==
			Enum.KeyCode.Four then

			choose(4)

		elseif input.KeyCode ==
			Enum.KeyCode.Five then

			choose(5)

		elseif input.KeyCode ==
			Enum.KeyCode.Six then

			choose(6)

		elseif input.KeyCode ==
			Enum.KeyCode.Seven then

			choose(7)

		end

	end
)

--==============================================================
-- SPEED UPDATE
--==============================================================

RunService.RenderStepped:Connect(
	function()

		if not currentVehicle
			or not currentVehicle.Parent then

			speed.Text =
				"0"

			return

		end

		local root =
			currentVehicle.PrimaryPart

		if not root then
			return
		end

		local velocity =
			root.AssemblyLinearVelocity

		local studsPerSecond =
			velocity.Magnitude

		speed.Text =
			tostring(
				math.floor(
					studsPerSecond
				)
			)

		if currentData then

			vehicleName.Text =
				currentData.Display
				..
				"   •   "
				..
				math.floor(
					studsPerSecond
				)
				..
				" studs/s"

			if studsPerSecond >
				currentData.MaxSpeed *
				0.85 then

				speed.TextColor3 =
					Color3.fromRGB(
						255,
						60,
						50
					)

			elseif studsPerSecond >
				currentData.MaxSpeed *
				0.55 then

				speed.TextColor3 =
					Color3.fromRGB(
						255,
						190,
						40
					)

			else

				speed.TextColor3 =
					Color3.new(
						1,
						1,
						1
					)

			end

		end

	end
)

--==============================================================
-- CAMERA FOLLOW
--==============================================================

RunService.RenderStepped:Connect(
	function()

		if not currentVehicle then
			return
		end

		local root =
			currentVehicle.PrimaryPart

		if not root then
			return
		end

		local seat =
			currentVehicle:FindFirstChild(
				"DriverSeat"
			)

		if not seat then
			return
		end

		if seat.Occupant then

			local camera =
				workspace.CurrentCamera

			camera.CameraType =
				Enum.CameraType.Scriptable

			local behind =
				-root.CFrame.LookVector *
				22

			local position =
				root.Position +
				behind +
				Vector3.new(
					0,
					8,
					0
				)

			local target =
				root.Position +
				Vector3.new(
					0,
					2,
					0
				)

			local desired =
				CFrame.lookAt(
					position,
					target
				)

			camera.CFrame =
				camera.CFrame:Lerp(
					desired,
					0.1
				)

		end

	end
)

