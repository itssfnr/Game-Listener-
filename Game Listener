local function AddWheel(
	car,
	body,
	name,
	pos,
	radius
)

	local wheel = Instance.new("Part")

	wheel.Name = name

	wheel.Shape = Enum.PartType.Cylinder

	wheel.Size =
		Vector3.new(
			1.15,
			radius*2,
			radius*2
		)

	wheel.Color =
		Color3.fromRGB(12,12,13)

	wheel.Material =
		Enum.Material.Rubber

	wheel.CanCollide = false

	wheel.Massless = true

	wheel.CFrame =
		body.CFrame *
		CFrame.new(pos) *
		CFrame.Angles(0,0,math.rad(90))

	wheel.Parent = car

	Weld(body,wheel)

	return wheel
end

