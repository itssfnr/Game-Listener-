--==============================================================
-- PHYSICS
--==============================================================

local function VehiclePhysics(dt)

	if not driving then
		return
	end

	if not activeBody then
		return
	end

	if not activeBody.Parent then
		return
	end

	local body = activeBody

	local velocity =
		body.AssemblyLinearVelocity

	local forward =
		body.CFrame.LookVector

	local right =
		body.CFrame.RightVector

	local forwardVelocity =
		velocity:Dot(forward)

	local lateralVelocity =
		velocity:Dot(right)

	-- throttle

	if keys.W then

		body:ApplyImpulse(
			forward *
			selectedConfig.Acceleration *
			body.AssemblyMass *
			dt
		)

	end

	if keys.S then

		if forwardVelocity > 5 then

			body:ApplyImpulse(
				-forward *
				selectedConfig.Braking *
				body.AssemblyMass *
				dt
			)

		else

			body:ApplyImpulse(
				-forward *
				selectedConfig.Acceleration *
				.65 *
				body.AssemblyMass *
				dt
			)

		end

	end

	-- steering

	local steering = 0

	if keys.A then
		steering = -1
	elseif keys.D then
		steering = 1
	end

	local speedFactor =
		math.clamp(
			math.abs(forwardVelocity)/35,
			.15,
			1.35
		)

	local steerPower =
		selectedConfig.Steering *
		speedFactor

	if keys.Shift then
		steerPower *= 1.4
	end

	if math.abs(forwardVelocity) > 2
	and steering ~= 0 then

		body.AssemblyAngularVelocity =
			Vector3.new(
				0,
				-steering *
				steerPower,
				0
			)

	end

	-- grip

	local grip

	if keys.Shift then
		grip = selectedConfig.DriftGrip
	else
		grip = selectedConfig.Grip
	end

	local sideCorrection =
		right *
		lateralVelocity *
		grip

	body:ApplyImpulse(
		-sideCorrection *
		body.AssemblyMass *
		dt
	)

	-- handbrake

	if keys.Space then

		body.AssemblyLinearVelocity *=
			math.max(
				0,
				1-dt*3.5
			)

	end

	-- speed limiter

	local maxSpeed =
		selectedConfig.Speed

	local horizontal =
		Vector3.new(
			velocity.X,
			0,
			velocity.Z
		)

	if horizontal.Magnitude > maxSpeed then

		local limited =
			horizontal.Unit *
			maxSpeed

		body.AssemblyLinearVelocity =
			Vector3.new(
				limited.X,
				velocity.Y,
				limited.Z
			)

	end

	-- drift indicator

	if keys.Shift
	and math.abs(lateralVelocity) > 4
	and math.abs(forwardVelocity) > 15 then

		driftLabel.Text = "🔥 DRIFT"

	else

		driftLabel.Text = ""

	end

end

--==============================================================
-- CAMERA
--==============================================================

local function UpdateCamera()

	if not driving then
		return
	end

	if not activeBody then
		return
	end

	local camera = workspace.CurrentCamera

	local body = activeBody

	local velocity =
		body.AssemblyLinearVelocity

	local speed =
		velocity.Magnitude

	local distance =
		18 +
		math.clamp(
			speed/15,
			0,
			10
		)

	local height =
		6.5 +
		math.clamp(
			speed/50,
			0,
			4
		)

	local cameraPosition =
		body.Position -
		body.CFrame.LookVector *
		distance +
		Vector3.new(
			0,
			height,
			0
		)

	local target =
		body.Position +
		Vector3.new(
			0,
			1.5,
			0
		)

	local wanted =
		CFrame.lookAt(
			cameraPosition,
			target
		)

	camera.CameraType =
		Enum.CameraType.Scriptable

	camera.CFrame =
		camera.CFrame:Lerp(
			wanted,
			.13
		)

end

--==============================================================
-- HUD
--==============================================================

local function UpdateHUD()

	if not driving or not activeBody then
		hud.Visible = false
		return
	end

	hud.Visible = true

	local speed =
		math.floor(
			activeBody.AssemblyLinearVelocity.Magnitude
		)

	speedLabel.Text =
		tostring(speed)

	if selectedConfig then

		if speed >
			selectedConfig.Speed*.85 then

			speedLabel.TextColor3 =
				Color3.fromRGB(
					255,
					65,
					50
				)

		elseif speed >
			selectedConfig.Speed*.55 then

			speedLabel.TextColor3 =
				Color3.fromRGB(
					255,
					190,
					55
				)

		else

			speedLabel.TextColor3 =
				Color3.fromRGB(
					245,
					245,
					250
				)

		end

	end

end

