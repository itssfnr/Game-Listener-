--==============================================================
-- VEHICLE PHYSICS
--==============================================================

local function UpdateVehicle(
	dt
)

	if not CONFIG.PhysicsUpdate then
		return
	end

	if not CurrentVehicle then
		return
	end

	if not CurrentVehicle.Parent then
		return
	end

	local data =
		CurrentVehicleData

	if not data then
		return
	end

	local body =
		CurrentVehicle.PrimaryPart

	if not body then
		return
	end

	--==========================================================
	-- INPUT
	--==========================================================

	local throttle =
		0

	if Keys.W then
		throttle += 1
	end

	if Keys.S then
		throttle -= 1
	end

	local steering =
		0

	if Keys.A then
		steering -= 1
	end

	if Keys.D then
		steering += 1
	end

	--==========================================================
	-- ACCELERATION
	--==========================================================

	if throttle > 0 then

		CurrentSpeed =
			CurrentSpeed +
			data.Acceleration *
			dt

		if CurrentSpeed >
			data.MaxSpeed then

			CurrentSpeed =
				data.MaxSpeed

		end

	elseif throttle < 0 then

		if CurrentSpeed > 5 then

			CurrentSpeed =
				CurrentSpeed -
				data.BrakePower *
				dt

			if CurrentSpeed < 0 then
				CurrentSpeed = 0
			end

		else

			CurrentSpeed =
				CurrentSpeed -
				data.Acceleration *
				0.5 *
				dt

			if CurrentSpeed <
				-data.ReverseSpeed then

				CurrentSpeed =
					-data.ReverseSpeed

			end

		end

	else

		-- Natural drag

		if CurrentSpeed > 0 then

			CurrentSpeed =
				CurrentSpeed -
				8 *
				dt

			if CurrentSpeed < 0 then
				CurrentSpeed = 0
			end

		elseif CurrentSpeed < 0 then

			CurrentSpeed =
				CurrentSpeed +
				8 *
				dt

			if CurrentSpeed > 0 then
				CurrentSpeed = 0
			end

		end

	end

	--==========================================================
	-- STEERING
	--==========================================================

	local speedRatio =
		math.clamp(
			math.abs(CurrentSpeed) /
			math.max(
				data.MaxSpeed,
				1
			),
			0,
			1
		)

	local steeringStrength =
		data.SteerSpeed *
		(
			0.2 +
			speedRatio *
			0.8
		)

	if math.abs(CurrentSpeed) > 1 then

		local turn =
			steering *
			steeringStrength *
			dt

		if CurrentSpeed < 0 then
			turn = -turn
		end

		body.CFrame =
			body.CFrame *
			CFrame.Angles(
				0,
				-turn,
				0
			)

	end

	--==========================================================
	-- MOVEMENT
	--==========================================================

	local movement =
		body.CFrame.LookVector *
		CurrentSpeed *
		dt

	local newPosition =
		body.Position +
		movement

	--==========================================================
	-- GROUND LIMIT
	--==========================================================

	local minimumY =
		2.5

	if newPosition.Y <
		minimumY then

		newPosition =
			Vector3.new(
				newPosition.X,
				minimumY,
				newPosition.Z
			)

	end

	--==========================================================
	-- BODY MOVEMENT
	--==========================================================

	local rotation =
		body.CFrame -
		body.CFrame.Position

	body.CFrame =
		CFrame.new(
			newPosition
		) *
		rotation

	--==========================================================
	-- MOVE VEHICLE PARTS
	--==========================================================

	for _, object in
		ipairs(
			CurrentVehicle:GetChildren()
		) do

		if object:IsA("BasePart")
			and object ~= body then

			local relative =
				body.CFrame:ToObjectSpace(
					object.CFrame
				)

			-- Store relative position
			-- only when first encountered

			local stored =
				object:GetAttribute(
					"RelativeX"
				)

			if stored == nil then

				local rx, ry, rz =
					relative:ToEulerAnglesXYZ()

				object:SetAttribute(
					"RelativeX",
					relative.Position.X
				)

				object:SetAttribute(
					"RelativeY",
					relative.Position.Y
				)

				object:SetAttribute(
					"RelativeZ",
					relative.Position.Z
				)

				object:SetAttribute(
					"RotX",
					rx
				)

				object:SetAttribute(
					"RotY",
					ry
				)

				object:SetAttribute(
					"RotZ",
					rz
				)

			end

		end

	end

end

--==============================================================
-- BETTER VISUAL PART FOLLOW
--==============================================================

local function UpdateVehicleVisuals()

	if not CurrentVehicle then
		return
	end

	local body =
		CurrentVehicle.PrimaryPart

	if not body then
		return
	end

	for _, object in
		ipairs(
			CurrentVehicle:GetChildren()
		) do

		if object:IsA("BasePart")
			and object ~= body then

			local x =
				object:GetAttribute(
					"RelativeX"
				)

			local y =
				object:GetAttribute(
					"RelativeY"
				)

			local z =
				object:GetAttribute(
					"RelativeZ"
				)

			local rx =
				object:GetAttribute(
					"RotX"
				)

			local ry =
				object:GetAttribute(
					"RotY"
				)

			local rz =
				object:GetAttribute(
					"RotZ"
				)

			if x and y and z then

				object.CFrame =
					body.CFrame *
					CFrame.new(
						x,
						y,
						z
					) *
					CFrame.Angles(
						rx or 0,
						ry or 0,
						rz or 0
					)

			end

		end

	end

end

--==============================================================
-- CAMERA
--==============================================================

local function UpdateCamera()

	if not CurrentVehicle then
		return
	end

	local body =
		CurrentVehicle.PrimaryPart

	if not body then
		return
	end

	local character =
		Player.Character

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not humanoid then
		return
	end

	local seat =
		CurrentVehicle:FindFirstChild(
			"DriverSeat"
		)

	if not seat then
		return
	end

	if seat.Occupant then

		Camera.CameraType =
			Enum.CameraType.Scriptable

		local behind =
			-body.CFrame.LookVector *
			CONFIG.CameraDistance

		local cameraPosition =
			body.Position +
			behind +
			Vector3.new(
				0,
				CONFIG.CameraHeight,
				0
			)

		local lookAt =
			body.Position +
			Vector3.new(
				0,
				2,
				0
			)

		local target =
			CFrame.lookAt(
				cameraPosition,
				lookAt
			)

		Camera.CFrame =
			Camera.CFrame:Lerp(
				target,
				0.12
			)

	else

		if Camera.CameraType ==
			Enum.CameraType.Scriptable then

			Camera.CameraType =
				Enum.CameraType.Custom

		end

	end

end

--==============================================================
-- SPEED DISPLAY
--==============================================================

local function UpdateSpeedometer()

	local speed =
		math.abs(
			CurrentSpeed
		)

	SpeedLabel.Text =
		tostring(
			math.floor(
				speed
			)
		)

	if CurrentVehicleData then

		VehicleLabel.Text =
			CurrentVehicleData.DisplayName
			..
			"  •  "
			..
			CurrentVehicleData.Type

	end

	if speed >
		CurrentVehicleData.MaxSpeed *
		0.85 then

		SpeedLabel.TextColor3 =
			Color3.fromRGB(
				255,
				70,
				50
			)

	elseif speed >
		CurrentVehicleData.MaxSpeed *
		0.55 then

		SpeedLabel.TextColor3 =
			Color3.fromRGB(
				255,
				190,
				40
			)

	else

		SpeedLabel.TextColor3 =
			Color3.fromRGB(
				255,
				255,
				255
			)

	end

end

--==============================================================
-- SEAT PLAYER
--==============================================================

local function PutPlayerInVehicle()

	if not CurrentVehicle then
		return
	end

	local character =
		Player.Character

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	local seat =
		CurrentVehicle:FindFirstChild(
			"DriverSeat"
		)

	if not humanoid
		or not root
		or not seat then

		return
	end

	root.CFrame =
		seat.CFrame *
		CFrame.new(
			0,
			3,
			0
		)

	task.wait(0.1)

	seat:Sit(
		humanoid
	)

end

