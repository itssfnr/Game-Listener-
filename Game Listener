--==============================================================
-- VEHICLE PHYSICS
--==============================================================

local function DriveVehicle(dt)

	if not currentCar
	or not currentCar.Parent
	or not currentCar.PrimaryPart then
		return
	end

	local body =
		currentCar.PrimaryPart

	local velocity =
		body.AssemblyLinearVelocity

	local forward =
		body.CFrame.LookVector

	local right =
		body.CFrame.RightVector

	local forwardSpeed =
		velocity:Dot(forward)

	local sideSpeed =
		velocity:Dot(right)

	-- throttle

	if keys.W then
		throttle = 1
	elseif keys.S then
		throttle = -1
	else
		throttle = 0
	end

	-- steering

	if keys.A then
		steering = -1
	elseif keys.D then
		steering = 1
	else
		steering = 0
	end

	--==========================================================
	-- ENGINE FORCE
	--==========================================================

	if throttle > 0 then

		local force =
			currentConfig.accel *
			1000

		body:ApplyImpulse(
			forward *
			force *
			dt
		)

	elseif throttle < 0 then

		body:ApplyImpulse(
			-forward *
			currentConfig.brake *
			1000 *
			dt
		)

	end

	--==========================================================
	-- LIMIT SPEED
	--==========================================================

	local max =
		currentConfig.speed

	if forwardSpeed > max then

		body.AssemblyLinearVelocity =
			velocity -
			forward *
			(forwardSpeed-max)

	end

	--==========================================================
	-- SIDE GRIP
	--==========================================================

	local grip =
		currentConfig.drift

	if keys.Shift then
		grip *= 0.18
	end

	if keys.Space then
		grip *= 0.08
	end

	local sideCorrection =
		right *
		sideSpeed *
		grip

	body:ApplyImpulse(
		-sideCorrection *
		body.AssemblyMass *
		dt
	)

	--==========================================================
	-- STEERING
	--==========================================================

	if math.abs(forwardSpeed) > 2 then

		local steeringStrength =
			currentConfig.turn *
			math.clamp(
				math.abs(forwardSpeed) /
				40,
				0.2,
				1.5
			)

		if keys.Shift then
			steeringStrength *= 1.35
		end

		body.AssemblyAngularVelocity =
			Vector3.new(
				0,
				-steering *
				steeringStrength,
				0
			)

	end

	--==========================================================
	-- DRIFT DISPLAY
	--==========================================================

	if keys.Shift
	and math.abs(sideSpeed) > 5
	and math.abs(forwardSpeed) > 10 then

		driftText.Text =
			"🔥 DRIFT"

	else

		driftText.Text =
			""

	end

	--==========================================================
	-- BRAKE
	--==========================================================

	if keys.Space then

		body.AssemblyLinearVelocity *=
			math.max(
				0,
				1 - dt*3
			)

	end

end

--==============================================================
-- CAMERA
--==============================================================

local function UpdateCamera()

	if not currentCar
	or not currentCar.PrimaryPart then
		return
	end

	local body =
		currentCar.PrimaryPart

	local camera =
		workspace.CurrentCamera

	local speed =
		body.AssemblyLinearVelocity.Magnitude

	local distance =
		20 +
		math.clamp(
			speed/20,
			0,
			8
		)

	local height =
		7 +
		math.clamp(
			speed/40,
			0,
			3
		)

	local target =
		body.Position +
		Vector3.new(
			0,
			2,
			0
		)

	local position =
		body.Position -
		body.CFrame.LookVector *
		distance +
		Vector3.new(
			0,
			height,
			0
		)

	local wanted =
		CFrame.lookAt(
			position,
			target
		)

	camera.CameraType =
		Enum.CameraType.Scriptable

	camera.CFrame =
		camera.CFrame:Lerp(
			wanted,
			0.12
		)

end

--==============================================================
-- SPEED UI
--==============================================================

local function UpdateSpeed()

	if not currentCar
	or not currentCar.PrimaryPart then

		speedText.Text =
			"0"

		return
	end

	local velocity =
		currentCar.PrimaryPart.AssemblyLinearVelocity

	local speed =
		math.floor(
			velocity.Magnitude
		)

	speedText.Text =
		tostring(speed)

	if currentConfig then

		if speed >
			currentConfig.speed*0.85 then

			speedText.TextColor3 =
				Color3.fromRGB(
					255,
					70,
					50
				)

		elseif speed >
			currentConfig.speed*0.55 then

			speedText.TextColor3 =
				Color3.fromRGB(
					255,
					190,
					50
				)

		else

			speedText.TextColor3 =
				Color3.fromRGB(
					240,
					240,
					245
				)

		end

	end

end

