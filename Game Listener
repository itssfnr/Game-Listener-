local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local gui = Instance.new("ScreenGui")
gui.Name = "AimTraining"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Size = UDim2.fromOffset(180, 45)
button.Position = UDim2.fromOffset(20, 100)
button.Text = "Aim Assist: OFF"
button.TextSize = 18
button.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
button.TextColor3 = Color3.new(1, 1, 1)
button.Parent = gui

local enabled = false

button.MouseButton1Click:Connect(function()
	enabled = not enabled
	button.Text = enabled and "Aim Assist: ON" or "Aim Assist: OFF"
	button.BackgroundColor3 = enabled
		and Color3.fromRGB(40, 130, 70)
		or Color3.fromRGB(35, 35, 40)
end)

local function getNearestDummy()
	local nearest
	local distance = math.huge

	for _, obj in ipairs(workspace:GetChildren()) do
		if obj:IsA("Model") and obj:GetAttribute("AimTrainingDummy") then
			local head = obj:FindFirstChild("Head")

			if head then
				local screenPos, visible =
					camera:WorldToViewportPoint(head.Position)

				if visible then
					local center = Vector2.new(
						camera.ViewportSize.X / 2,
						camera.ViewportSize.Y / 2
					)

					local d = (
						Vector2.new(screenPos.X, screenPos.Y) - center
					).Magnitude

					if d < distance then
						distance = d
						nearest = head
					end
				end
			end
		end
	end

	return nearest
end

RunService.RenderStepped:Connect(function()
	if not enabled then
		return
	end

	local head = getNearestDummy()

	if head then
		camera.CFrame = CFrame.lookAt(
			camera.CFrame.Position,
			head.Position
		)
	end
end)
