local function glass(parent,name,size,cf)

	local g = childPart(
		parent,
		name,
		size,
		cf,
		Color3.fromRGB(35,75,105),
		Enum.Material.Glass
	)

	g.Transparency = .22

	return g
end

local function light(parent,name,size,cf,color)

	return childPart(
		parent,
		name,
		size,
		cf,
		color,
		Enum.Material.Neon
	)

end

--==============================================================
-- WHEEL
--==============================================================

local function AddWheel(
	model,
	chassis,
	name,
	offset,
	radius
)

	local wheel = Instance.new("Part")

	wheel.Name = name
	wheel.Shape = Enum.PartType.Cylinder

	wheel.Size = Vector3.new(
		1.1,
		radius*2,
		radius*2
	)

	wheel.Color = Color3.fromRGB(8,8,10)
	wheel.Material = Enum.Material.Rubber

	wheel.CanCollide = false
	wheel.CanTouch = false
	wheel.CanQuery = false
	wheel.Massless = true

	wheel.CFrame =
		chassis.CFrame *
		CFrame.new(offset) *
		CFrame.Angles(0,0,math.rad(90))

	wheel.Parent = model

	weld(chassis,wheel)

	local rim = Instance.new("Part")

	rim.Name = "Rim"
	rim.Shape = Enum.PartType.Cylinder

	rim.Size = Vector3.new(
		1.15,
		radius*1.25,
		radius*1.25
	)

	rim.Color = Color3.fromRGB(180,180,185)
	rim.Material = Enum.Material.Metal

	rim.CanCollide = false
	rim.CanTouch = false
	rim.CanQuery = false
	rim.Massless = true

	rim.CFrame = wheel.CFrame
	rim.Parent = model

	weld(wheel,rim)

	return wheel
end

